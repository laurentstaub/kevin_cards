# Railway Database Configuration
# Railway will automatically provide DATABASE_URL, but you can also use individual variables
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

# Server Configuration
PORT=8084
NODE_ENV=production

# CORS Origins (comma-separated)
# Update this with your Railway frontend URL
CORS_ORIGINS=https://your-app-name.up.railway.app

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: JWT Secret (if using authentication)
JWT_SECRET=

# Optional: API Keys or other secrets
API_SECRET_KEY=