# FlashPharma - Configuration d'environnement
# Copier ce fichier vers .env et ajuster les valeurs.

# --- Serveurs ---
NODE_ENV=development
# Port du serveur frontend (fichiers statiques + proxy /api)
FRONTEND_PORT=8080
# Port du serveur API
API_PORT=3001
# URL du frontend, utilisee pour la configuration CORS de l'API
FRONTEND_URL=http://localhost:8080

# En production (Railway, etc.), la plateforme injecte PORT : il a la priorite
# sur FRONTEND_PORT et API_PORT.
# PORT=3001

# Sert le frontend et l'admin depuis le processus API (deploiement mono-processus).
# Active automatiquement quand NODE_ENV=production.
# SERVE_STATIC=true

# Cible du proxy /api du serveur frontend. Par defaut http://localhost:API_PORT.
# API_URL=http://localhost:3001

# --- Base de donnees ---
# Fichier SQLite. Cree automatiquement au premier demarrage.
SQLITE_DB_PATH=./database/flashpharma.db

# --- Limitation de debit ---
RATE_LIMIT_WINDOW_MS=900000
# Par defaut : 1000 en developpement, 100 en production
RATE_LIMIT_MAX_REQUESTS=1000

# --- Journalisation ---
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=false
LOGS_DIR=./logs

# --- Divers ---
BODY_PARSER_LIMIT=10mb

# Generation de contenu assistee (scripts de tools/)
# GEMINI_API_KEY=

# Reserve a une future authentification
# JWT_SECRET=
# JWT_EXPIRATION=24h
